COMPOSE_PROJECT_NAME=markorbit-data-engine
RAW_DATA_PATH=D:/yoomarks/markorbit-data-engine/raw_data
# Visual storage can be split by media. Keep these defaults on the existing
# raw_data tree until dedicated disks are ready. On Windows, examples are:
# VISUAL_RAW_PATH=F:/markorbit-raw-visual
# VISUAL_PROCESSED_PATH=E:/markorbit-visual
VISUAL_RAW_PATH=./raw_data
VISUAL_PROCESSED_PATH=./raw_data/visual_processed

# Optional external persistent database storage. These variables are ignored by
# the default docker-compose.yml and are used only when explicitly adding
# docker-compose.external-storage.yml. Do not point them at empty directories on
# a live host until the migration/cutover runbook has been completed.
# Windows examples:
# POSTGRES_DATA_PATH=E:/MarkOrbitData/postgres
# CLICKHOUSE_DATA_PATH=E:/MarkOrbitData/clickhouse
# CLICKHOUSE_LOG_PATH=E:/MarkOrbitData/clickhouse-logs

POSTGRES_DB=markorbit_control
POSTGRES_USER=markorbit
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

CLICKHOUSE_DB=markorbit_facts
CLICKHOUSE_USER=markorbit
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Large CN package aggregation safety defaults. These cap parallel aggregation
# pressure and allow GROUP BY / sort work to spill to the ClickHouse data volume.
CLICKHOUSE_MAX_THREADS=4
CLICKHOUSE_EXTERNAL_GROUP_BY_BYTES=536870912
CLICKHOUSE_EXTERNAL_SORT_BYTES=536870912

API_PORT=8080
LOG_LEVEL=INFO
CN_SCAN_INTERVAL_SECONDS=300
# Contacts under raw_data/incoming/contacts are auto-discovered into managed tasks.
# Discovery never auto-applies an import; apply remains an explicit admin action.
CONTACT_SCAN_INTERVAL_SECONDS=60

# CN QCC enrichment is opt-in and runs as a separate scheduler-friendly cycle.
# Enabling it does not change the existing CN/contact worker behavior.
CN_QCC_ACQUISITION_ENABLED=false
CN_QCC_CAPACITY=500
CN_QCC_REFRESH_DAYS=180
CN_QCC_CYCLE_INTERVAL_SECONDS=3600
# Block periodic acquisition when an open batch has waited longer than this.
CN_QCC_STALE_BATCH_HOURS=168
# Optional overrides. When omitted, paths resolve under RAW_DATA_ROOT:
# CN_QCC_OUTGOING_ROOT=/data/raw/outgoing/cn_qcc
# CN_QCC_INCOMING_ROOT=/data/raw/incoming/cn_qcc

# /api/v1 service-to-service authentication. Keep disabled for local compatibility.
# Production deployments should switch to required and use keys >= 32 characters.
# Multiple comma-separated keys allow overlap during key rotation.
INTEGRATION_AUTH_MODE=disabled
INTEGRATION_API_KEYS=

# USPTO Open Data Portal Product Data metadata fetch. Keep the API key only in
# local/secret environment configuration. The header name is intentionally explicit
# rather than guessed; set it to the header documented for the issued ODP API key.
USPTO_ODP_API_KEY=
USPTO_ODP_API_KEY_HEADER=

US_DOWNLOAD_ENABLED=false
US_BASE_URL=